    def test_episode_id_falls_back_when_guid_missing(self):
        data = rss_bytes(
            """
            <item>
              <title>Episode Without GUID</title>
              <pubDate>Tue, 22 Sep 2026 10:00:00 GMT</pubDate>
              <enclosure
                  url="https://example.com/fallback.mp3"
